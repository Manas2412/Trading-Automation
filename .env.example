# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- Zerodha Kite Connect ---
KITE_API_KEY=
KITE_API_SECRET=
# Access token is generated daily via the login flow; stored locally, not here.

# --- Database (TimescaleDB / Postgres) ---
DATABASE_URL=postgresql://qtrade:changeme@localhost:5432/qtrade

# --- Runtime ---
QTRADE_ENV=dev            # dev | paper | live
LOG_LEVEL=INFO

# --- Safety switches ---
LIVE_TRADING_ENABLED=false   # master guard; must be explicitly true for real orders
MAX_DAILY_LOSS_PCT=2.0       # kill-switch threshold (percent of capital)
