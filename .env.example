# Copy to .env and fill in AS EACH SERVICE COMES ONLINE. .env is git-ignored —
# never commit real keys. `git status` should never show .env.

# =========================================================================
# Phase 0 — needed for data ingestion & storage
# =========================================================================

# --- Zerodha Kite Connect ---
KITE_API_KEY=
KITE_API_SECRET=
# Access token is generated daily via the login flow; stored locally, not here.

# --- Database (TimescaleDB / Postgres) ---
DATABASE_URL=postgresql://qtrade:changeme@localhost:5432/qtrade

# =========================================================================
# Runtime & safety
# =========================================================================
QTRADE_ENV=dev               # dev | paper | live
LOG_LEVEL=INFO
LIVE_TRADING_ENABLED=false   # master guard; must be explicitly true for real orders
MAX_DAILY_LOSS_PCT=2.0       # kill-switch threshold (percent of capital)
MAX_POSITION_PCT=10.0        # per-name cap (percent of capital)
MAX_GROSS_LEVERAGE=1.0

# =========================================================================
# Phase 1 — LLM news/sentiment FEATURE layer (AWS Bedrock)
# Not needed until Phase 1. LLM output is an upstream feature only — never a trade trigger.
# Prefer the AWS credential chain over static keys:
#   - dev machine: set AWS_PROFILE and use ~/.aws/credentials
#   - execution VM: attach an IAM role (no keys on disk)
# If you must use static keys, scope the IAM policy to bedrock:InvokeModel on this model/region only.
# =========================================================================
AWS_REGION=ap-south-1
AWS_PROFILE=                 # preferred: named profile from ~/.aws/credentials
# AWS_ACCESS_KEY_ID=         # only if not using a profile / IAM role
# AWS_SECRET_ACCESS_KEY=     # only if not using a profile / IAM role
BEDROCK_MODEL_ID=            # e.g. an Anthropic Claude model id available in your region
BEDROCK_ENABLED=false        # gate the LLM feature pipeline on/off
